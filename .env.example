# Database
POSTGRES_USER=usageflow
POSTGRES_PASSWORD=usageflow_dev
POSTGRES_DB=usageflow
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=8000
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
DEBUG=true

# LiteLLM
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_SALT_KEY=sk-litellm-salt-key

# LLM Provider API Keys (add your keys)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Internal API Key for LiteLLM callback
USAGEFLOW_INTERNAL_API_KEY=internal-api-key

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_LITELLM_URL=http://localhost:4000

# Stripe (use test mode keys for local development)
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
