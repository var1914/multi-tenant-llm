# UsageFlow Production Environment Configuration
# Copy this file to .env.production and fill in your values

# =============================================================================
# REQUIRED SECRETS (Must be changed!)
# =============================================================================

# Database
POSTGRES_USER=usageflow
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=usageflow

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE

# Internal API Key (for service-to-service communication)
USAGEFLOW_INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY_HERE

# LiteLLM Keys
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY
LITELLM_SALT_KEY=YOUR_LITELLM_SALT_KEY

# LLM Provider Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://your-domain.com

# =============================================================================
# PORTS
# =============================================================================

API_PORT=8000
FRONTEND_PORT=3000
LITELLM_PORT=4000
PGBOUNCER_PORT=6432
REDIS_PORT=6379

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# API Workers (set to 2x CPU cores, e.g., 8 for 4-core instance)
API_WORKERS=4

# Enable PgBouncer mode (disable SQLAlchemy pooling)
USE_PGBOUNCER=true

# SQLAlchemy pool settings (smaller when using PgBouncer)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# JWT Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# =============================================================================
# MONITORING (Optional)
# =============================================================================

# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# DataDog for APM
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com
