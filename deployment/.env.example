# =============================================================================
# TokenTrail Production Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (RDS PostgreSQL)
# -----------------------------------------------------------------------------
# Get these from Terraform output: terraform output rds_endpoint
DATABASE_URL=postgresql+asyncpg://tokentrail:PASSWORD@RDS_ENDPOINT:5432/tokentrail
SYNC_DATABASE_URL=postgresql://tokentrail:PASSWORD@RDS_ENDPOINT:5432/tokentrail

# Postgres credentials (for migrations)
POSTGRES_USER=tokentrail
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=tokentrail

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Get from Terraform: terraform output jwt_secret
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Internal API key (for service-to-service communication)
# Get from Terraform: terraform output internal_api_key
USAGEFLOW_INTERNAL_API_KEY=YOUR_INTERNAL_API_KEY

# -----------------------------------------------------------------------------
# LiteLLM Configuration
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-tokentrail-master-key-change-me
LITELLM_SALT_KEY=sk-salt-change-me

# API Keys for LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
API_WORKERS=2

# Domain
DOMAIN_NAME=tokentrailapp.com
FRONTEND_URL=https://tokentrailapp.com

# -----------------------------------------------------------------------------
# Monitoring & Alerts (Optional)
# -----------------------------------------------------------------------------
# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Email for critical alerts
ALERT_EMAIL=tokentrailapp@gmail.com

# AWS Region (for CloudWatch logging)
AWS_REGION=eu-central-1

# -----------------------------------------------------------------------------
# Stripe Integration (Optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Redis (Local on EC2)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
