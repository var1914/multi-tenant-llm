# TokenTrail E2E Test Configuration
# Copy this file to .env.e2e and fill in your values

# Base URL for the application
E2E_BASE_URL=https://tokentrailapp.com

# API Base URL (usually same as BASE_URL)
E2E_API_URL=https://tokentrailapp.com

# Test user credentials
# Create a dedicated test account for E2E testing
E2E_TEST_EMAIL=test@tokentrailapp.com
E2E_TEST_PASSWORD=TestPassword123!
E2E_TEST_COMPANY=E2E Test Company

# API Key for making real LLM requests
# Generate from: https://tokentrailapp.com/app/api-keys
E2E_API_KEY=your_tokentrail_api_key_here

# (Optional) Pre-approved trial email for testing trial credits flow
E2E_APPROVED_TRIAL_EMAIL=approved_trial@test.tokentrailapp.com
